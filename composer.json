{
  "name": "areypurnawan/whatsapp-gateway",
  "description": "Laravel package to provide Whatsapp gateway integration. Whatsapp channel for Laravel notifications also included.",
  "license": "MIT",
  "keywords": [
    "laravel whatsapp gateway",
    "laravel notifications",
    "laravel whatsapp sender",
    "laravel whatsapp notifications"
  ],
  "homepage": "https://github.com/areypurnawan/whatsapp-gateway",
  "authors": [
    {
      "name": "Ari Purnawan",
      "email": "areypurnawan@gmail.com",
      "homepage": "https://github.com/areypurnawan",
      "role": "Developer"
    }
  ],
  "type": "library",
  "require": {
    "php": "^7.2|^7.3|^7.4|^8.0",
    "illuminate/support": "^11.0|^12.0",
    "guzzlehttp/guzzle": "~6.0|^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^5.0|^6.0|^7.0|^8.0|^9.0",
    "phpunit/phpunit": "^8.0|^9.5.10|^10.5"
  },
  "autoload": {
    "psr-4": {
      "Areypurnawan\\WhatsappGateway\\": "src"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Areypurnawan\\WhatsappGateway\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Areypurnawan\\WhatsappGateway\\WhatsappGatewayServiceProvider"
      ],
      "aliases": {
        "WhatsappGateway": "Areypurnawan\\WhatsappGateway\\WhatsappGatewayFacade"
      }
    }
  }
}
